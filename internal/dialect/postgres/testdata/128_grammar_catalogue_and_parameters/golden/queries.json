    "SQL": "-- sgl.query(name: Bytes, command: many)\nSELECT octet_length(body) AS octets, bit_length(body) AS bits, get_byte(body, 0) AS first_byte, set_byte(body, 0, 1) AS set,\n    get_bit(body, 0) AS first_bit, bit_count(body) AS ones, ltrim(body, '\\x00'::bytea) AS trimmed,\n    overlay(body PLACING '\\x01'::bytea FROM 1) AS overlaid, length(body, 'UTF8') AS characters\nFROM places;",
    "Template": "SELECT ⟨c0 aliased:octet_length(body)⟩ AS octets, ⟨c1 aliased:bit_length(body)⟩ AS bits, ⟨c2 aliased:get_byte(body, 0)⟩ AS first_byte, ⟨c3 aliased:set_byte(body, 0, 1)⟩ AS set,\\n    ⟨c4 aliased:get_bit(body, 0)⟩ AS first_bit, ⟨c5 aliased:bit_count(body)⟩ AS ones, ⟨c6 aliased:ltrim(body, '\\\\x00'::bytea)⟩ AS trimmed,\\n    ⟨c7 aliased:overlay(body PLACING '\\\\x01'::bytea FROM 1)⟩ AS overlaid, ⟨c8 aliased:length(body, 'UTF8')⟩ AS characters\\nFROM places;"
  },
