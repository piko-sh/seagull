    "SQL": "-- sgl.query(name: Everyday, command: many)\nSELECT obj_description('places'::regclass, 'pg_class') AS described, col_description('places'::regclass, 1) AS column_described,\n    pg_database_size(current_database()) AS database_size, pg_relation_size('places') AS relation_size, date(created) AS day,\n    date_add(created, interval '1 day') AS tomorrow, date_subtract(created, interval '1 day', 'UTC') AS yesterday,\n    trim_array(tags, 1) AS trimmed, character_length(label) AS characters, txid_current() AS transaction_id,\n    pg_current_xact_id() AS current_xact_id\nFROM places;",
    "Template": "SELECT ⟨c0 aliased:obj_description('places'::regclass, 'pg_class')⟩ AS described, ⟨c1 aliased:col_description('places'::regclass, 1)⟩ AS column_described,\\n    ⟨c2 aliased:pg_database_size(current_database())⟩ AS database_size, ⟨c3 aliased:pg_relation_size('places')⟩ AS relation_size, ⟨c4 aliased:date(created)⟩ AS day,\\n    ⟨c5 aliased:date_add(created, interval '1 day')⟩ AS tomorrow, ⟨c6 aliased:date_subtract(created, interval '1 day', 'UTC')⟩ AS yesterday,\\n    ⟨c7 aliased:trim_array(tags, 1)⟩ AS trimmed, ⟨c8 aliased:character_length(label)⟩ AS characters, ⟨c9 aliased:txid_current()⟩ AS transaction_id,\\n    ⟨c10 aliased:pg_current_xact_id()⟩ AS current_xact_id\\nFROM places;"
  },
