    "ReadOnly": true,
    "SQL": "-- sgl.query(GullPredicates, many)\nSELECT id, wing \u003e 40 AS long_wing, span \u003e 100 AS wide, span IS NULL AS unmeasured, span IS NOT NULL AS measured,\n    wing IN (40, 42) AS listed, span IN (90, NULL) AS listed_span, wing IN (40, NULL) AS listed_wing,\n    span BETWEEN 90 AND 110 AS typical, wing \u003e 40 AND ringed AS long_and_ringed, tagged OR ringed AS marked,\n    wing \u003e 40 OR span \u003e 100 AS large, NOT (wing \u003e 40) AS short_wing, NOT tagged AS untagged, EXISTS (SELECT 1) AS present,\n    name LIKE 'Her%' AS herring_gull\nFROM gulls ORDER BY id;",
    "Template": "SELECT ⟨c0:id⟩, ⟨c1 aliased:wing \u003e 40⟩ AS long_wing, ⟨c2 aliased:span \u003e 100⟩ AS wide, ⟨c3 aliased:span IS NULL⟩ AS unmeasured, ⟨c4 aliased:span IS NOT NULL⟩ AS measured,\\n    ⟨c5 aliased:wing IN (40, 42)⟩ AS listed, ⟨c6 aliased:span IN (90, NULL)⟩ AS listed_span, ⟨c7 aliased:wing IN (40, NULL)⟩ AS listed_wing,\\n    ⟨c8 aliased:span BETWEEN 90 AND 110⟩ AS typical, ⟨c9 aliased:wing \u003e 40 AND ringed⟩ AS long_and_ringed, ⟨c10 aliased:tagged OR ringed⟩ AS marked,\\n    ⟨c11 aliased:wing \u003e 40 OR span \u003e 100⟩ AS large, ⟨c12 aliased:NOT (wing \u003e 40)⟩ AS short_wing, ⟨c13 aliased:NOT tagged⟩ AS untagged, ⟨c14 aliased:EXISTS (SELECT 1)⟩ AS present,\\n    ⟨c15 aliased:name LIKE 'Her%'⟩ AS herring_gull\\nFROM gulls ORDER BY id;"
