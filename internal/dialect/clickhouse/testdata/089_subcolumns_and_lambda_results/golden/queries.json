    "ReadOnly": true,
    "SQL": "-- sgl.query(LambdaResults, many)\nSELECT arrayMap(t -\u003e length(t), tags) AS tag_lengths, arrayMap((t, s) -\u003e concat(t, toString(s)), tags, sightings) AS labelled,\n       arrayFilter(t -\u003e t != '', tags) AS named, arrayFirst(t -\u003e t != '', tags) AS first_named,\n       arrayFirstOrNull(t -\u003e t != '', tags) AS maybe_named, arrayCount(s -\u003e s \u003e 1, sightings) AS busy_days,\n       arrayExists(s -\u003e s \u003e 1, sightings) AS any_busy, arraySum(s -\u003e s * 2, sightings) AS doubled_total,\n       arrayMax(t -\u003e length(t), tags) AS longest, arrayFold((total, s) -\u003e total + s, sightings, toUInt64(0)) AS folded,\n       arrayCumSum(s -\u003e s * 2, sightings) AS running, arrayMap(n -\u003e n, nicknames) AS same_nicknames,\n       arraySort(t -\u003e length(t), tags) AS by_length, nicknames[1] AS first_nickname\nFROM gulls;",
    "Template": "SELECT ⟨c0 aliased:arrayMap(t -\u003e length(t), tags)⟩ AS tag_lengths, ⟨c1 aliased:arrayMap((t, s) -\u003e concat(t, toString(s)), tags, sightings)⟩ AS labelled,\\n       ⟨c2 aliased:arrayFilter(t -\u003e t != '', tags)⟩ AS named, ⟨c3 aliased:arrayFirst(t -\u003e t != '', tags)⟩ AS first_named,\\n       ⟨c4 aliased:arrayFirstOrNull(t -\u003e t != '', tags)⟩ AS maybe_named, ⟨c5 aliased:arrayCount(s -\u003e s \u003e 1, sightings)⟩ AS busy_days,\\n       ⟨c6 aliased:arrayExists(s -\u003e s \u003e 1, sightings)⟩ AS any_busy, ⟨c7 aliased:arraySum(s -\u003e s * 2, sightings)⟩ AS doubled_total,\\n       ⟨c8 aliased:arrayMax(t -\u003e length(t), tags)⟩ AS longest, ⟨c9 aliased:arrayFold((total, s) -\u003e total + s, sightings, toUInt64(0))⟩ AS folded,\\n       ⟨c10 aliased:arrayCumSum(s -\u003e s * 2, sightings)⟩ AS running, ⟨c11 aliased:arrayMap(n -\u003e n, nicknames)⟩ AS same_nicknames,\\n       ⟨c12 aliased:arraySort(t -\u003e length(t), tags)⟩ AS by_length, ⟨c13 aliased:nicknames[1]⟩ AS first_nickname\\nFROM gulls;"
