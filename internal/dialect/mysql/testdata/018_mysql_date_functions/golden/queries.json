    "SQL": "-- sgl.query(name: FormattedSchedule, command: many)\nSELECT\n    id,\n    title,\n    DATE_FORMAT(scheduled_at, '%Y-%m-%d %H:%i') AS formatted_date,\n    DATEDIFF(scheduled_at, CURDATE()) AS days_until\nFROM appointments\nWHERE scheduled_at \u003e= CURDATE();",
