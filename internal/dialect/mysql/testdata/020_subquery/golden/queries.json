    "ReadOnly": true,
    "SQL": "-- sgl.query(name: CategoryStats, command: many)\nSELECT s.category, s.product_count, s.avg_price\nFROM (\n    SELECT category, COUNT(*) AS product_count, AVG(price) AS avg_price\n    FROM products\n    GROUP BY category\n) AS s\nORDER BY s.avg_price DESC;",
