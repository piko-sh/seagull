    "ReadOnly": true,
    "SQL": "-- sgl.query(name: MatchItems, command: many)\nSELECT\n    id,\n    id + 1 = ? AS matched,\n    CASE WHEN stock \u003e ? THEN 'many' ELSE 'few' END AS level\nFROM items\nWHERE price * 2 \u003e ?\n  AND coalesce(stock, 0) \u003c ?\n  AND name = ?;",
