    "SQL": "-- sgl.query(name: RankedScores, command: many)\nSELECT\n    player_name,\n    game,\n    score,\n    ROW_NUMBER() OVER (PARTITION BY game ORDER BY score DESC) AS rank_num,\n    RANK() OVER (PARTITION BY game ORDER BY score DESC) AS rank_pos\nFROM scores;",
